# ═══════════════════════════════════════════════════════════════
# openvibe.news — environment configuration (names only; never commit values)
# Copy to .env for development. Production: /etc/openvibe/news.env (0600).
# ═══════════════════════════════════════════════════════════════

# Server
PORT=4820
HOST=127.0.0.1
NODE_ENV=development
# Public origin: canonical URLs, feeds, sitemaps and JSON-LD are built from it
BASE_URL=http://localhost:4820
# Proxy hops that set X-Forwarded-For (Cloudflare → nginx → Node = 2)
TRUST_PROXY=2

# SQLite database (production unit: /var/lib/openvibe-news/news.db)
NEWS_DB_PATH=./data/news.db

# OpenVibe.Network — SSO (OAuth2), JWKS, client-credentials tokens
OV_NETWORK_URL=https://openvibe.network
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000
# OAuth client `news` (redirect https://openvibe.news/auth/callback). The same client is News'
# service principal svc:news for client-credentials grants (see README, "Grants").
OV_OAUTH_CLIENT_ID=news
OV_OAUTH_CLIENT_SECRET=
# Production: https://openvibe.news/auth/callback (default: BASE_URL + /auth/callback)
#OV_OAUTH_REDIRECT_URI=
# Cookies: Secure by default in production; set false for plain-http local development
#COOKIE_SECURE=false
# Signs the editor-desk form tokens (CSRF). Unset: random per process.
#NEWS_FORM_SECRET=

# Editors: Network subjects (usr_…), comma-separated. Network admins are editors too.
NEWS_EDITORS=

# OpenVibe.Sources — news items (sources.item.read; optionally sources.source.read for outlet names)
OV_SOURCES_INTERNAL_URL=http://127.0.0.1:4720
# Cursor pull (backstop for missed webhook deliveries); 0 turns it off
#NEWS_PULL_INTERVAL_MS=300000
#NEWS_PULL_PAGE_SIZE=100
#NEWS_PULL_MAX_PAGES=20
#NEWS_SOURCES_TIMEOUT_MS=8000

# Licensing: the longest source summary kept (and only when the source's terms allow short summaries)
#NEWS_SUMMARY_MAX_CHARS=280
# Clustering window
#NEWS_CLUSTER_WINDOW_HOURS=72

# OpenVibe.Events — the outbox relay runs only when EVENTS_URL and OV_OAUTH_CLIENT_SECRET are set
#EVENTS_URL=http://127.0.0.1:4300
#EVENTS_RELAY_INTERVAL_MS=2000
# Signing secret(s) of News' subscriptions (sources.item.*, sources.fetch.failed), comma-separated
# during rotation. Generate before `npm run subscribe` (e.g. `openssl rand -hex 32`).
# Unset = webhook off (503); the cursor pull still runs.
#NEWS_EVENTS_SECRET=

# OpenVibe.Community — the comment thread of each public story (referenced by id, never copied).
# Needs the grants community.comment.write and community.comment.moderate (audience openvibe.community);
# without them a story page says comments are unavailable.
OV_COMMUNITY_URL=https://openvibe.community
OV_COMMUNITY_INTERNAL_URL=http://127.0.0.1:4200

# OpenVibe.AI (optional) — news.summarize_story / news.compare_perspectives drafts (ai.run.create).
# Unset: no AI; editors write every story from the source items.
#OV_AI_INTERNAL_URL=http://127.0.0.1:4700
#NEWS_AI_WAIT_MS=30000

# Background worker (the Sources pull); off: NEWS_WORKER=off
#NEWS_WORKER=on

# Browser origins that may call /api/v1 with a Bearer Network JWT
#API_CORS_ORIGINS=https://openvibe.network,https://openvibe.live,https://openvibe.community

# release.json (openvibe-shared/release): the deployed commit when git is not available
#RELEASE_COMMIT=
#MIN_CLIENT_RELEASE=
