{
  "name": "openvibe-news",
  "version": "0.1.0",
  "private": true,
  "description": "OpenVibe.News — a source-backed publication product: source items from OpenVibe.Sources, dedupe, explainable clusters, editor-written stories whose every claim cites its sources, timelines, perspectives and correction/retraction revisions, server-rendered and useful without JavaScript.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "NODE_ENV=development node server/index.js",
    "test": "node test/run.js",
    "seed": "node scripts/seed.js",
    "subscribe": "node scripts/subscribe.js"
  },
  "keywords": ["openvibe", "news", "publishing", "sources", "feeds"],
  "author": "OpenVibers",
  "license": "AGPL-3.0-only",
  "repository": "github:OpenVibers/OpenVibe.News",
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "openvibe-contracts": "https://codeload.github.com/OpenVibers/OpenVibe.Contracts/tar.gz/refs/tags/v0.49.0",
    "openvibe-publishing": "https://codeload.github.com/OpenVibers/OpenVibe.Publishing/tar.gz/refs/tags/v0.4.0",
    "openvibe-sdk": "https://codeload.github.com/OpenVibers/OpenVibe.SDK/tar.gz/refs/tags/v0.11.0",
    "openvibe-shared": "https://codeload.github.com/OpenVibers/OpenVibe.Shared/tar.gz/refs/tags/v1.20.0"
  },
  "devDependencies": {
    "jsonwebtoken": "^9.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
