    "none"
  ],
  "quotaClass": "news-write",
  "events": [],
  "implementedBy": [
    "POST /api/v1/stories/:id/perspectives",
    "DELETE /api/v1/stories/:id/perspectives/:pid",
    "PUT /api/v1/stories/:id/sources/:item/perspective"
  ]
}
